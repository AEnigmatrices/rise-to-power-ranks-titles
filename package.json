{
  "name": "rise-to-power-ranks-titles",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive ranks, titles, and historical reference for Nobunaga's Ambition: Rise to Power.",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "pnpm run generate:favicons && astro dev",
    "check": "astro check --minimumFailingSeverity warning",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "validate": "pnpm run provenance:report && pnpm run check && pnpm run lint && pnpm run test",
    "build": "pnpm run validate && pnpm run build:site && pnpm run index:search",
    "preview": "astro preview",
    "astro": "astro",
    "build:site": "pnpm run generate:favicons && astro build",
    "index:search": "pnpm dlx pagefind@1.5.2 --site dist",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "provenance:report": "node scripts/report-provenance.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/noto-serif-jp": "^5.3.0",
    "@lucide/astro": "^1.48.0",
    "astro": "^7.3.5",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "fuse.js": "^7.5.0",
    "jpn-atlas": "^1.0.2",
    "motion": "^13.4.4",
    "topojson-client": "^3.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@12.7.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.6",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "~3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
