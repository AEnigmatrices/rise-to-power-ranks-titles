{
  "name": "rise-to-power-ranks-titles",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive ranks, titles, and historical reference for Nobunaga's Ambition: Rise to Power.",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "pnpm run generate:favicons && astro dev",
    "check": "astro check --minimumFailingSeverity warning",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "validate": "pnpm run provenance:report && pnpm run check && pnpm run lint && pnpm run test",
    "build": "pnpm run validate && pnpm run build:site && pnpm run index:search",
    "preview": "astro preview",
    "astro": "astro",
    "build:site": "pnpm run generate:favicons && astro build",
    "index:search": "pnpm dlx pagefind@1.5.2 --site dist",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "provenance:report": "node scripts/report-provenance.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/noto-serif-jp": "^5.3.0",
    "@lucide/astro": "^1.47.0",
    "astro": "^7.3.3",
    "d3-geo": "^3.1.1",
    "fuse.js": "^7.5.0",
    "jpn-atlas": "^1.0.2",
    "motion": "^13.4.0",
    "topojson-client": "^3.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.5",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "~3.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "sharp": "^0.35.4"
  }
}
