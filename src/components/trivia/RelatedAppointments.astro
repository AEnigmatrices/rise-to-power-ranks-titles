---
import { ArrowRight } from '@lucide/astro';
import type { Appointment } from '../../data/schema/appointments';
import { toReferenceEntries } from '../../lib/appointments';
import { appointmentPath } from '../../lib/routes';

interface Props {
    entries: Appointment[];
}

const { entries } = Astro.props;
const related = toReferenceEntries(entries);
---

<section class="related-appointments" aria-labelledby="related-appointments-heading">
    <div class="related-appointments__heading">
        <div>
            <p class="guide-section__kicker">Game reference</p>
            <h2 id="related-appointments-heading">Related appointments</h2>
        </div>
        <p>{related.length} {related.length === 1 ? 'appointment' : 'appointments'} in the catalogue.</p>
    </div>

    {
        related.length > 0 ? (
            <div class="related-appointments__grid">
                {related.map((entry) => (
                    <a class="related-appointment" href={appointmentPath(entry.id)}>
                        <span class="related-appointment__name">{entry.gameName}</span>
                        <span class="related-appointment__jp" lang="ja">{entry.japanese}</span>
                        <span class="related-appointment__reading">{entry.reading}</span>
                        <span class="related-appointment__meta">
                            {entry.className} · {entry.effect}
                        </span>
                        <ArrowRight size={14} stroke-width={1.8} aria-hidden="true" />
                    </a>
                ))}
            </div>
        ) : (
            <p class="guide-empty-note">
                This historical entry is contextual rather than tied to one specific catalogue appointment.
            </p>
        )
    }
</section>
