---
import { ArrowLeft } from '@lucide/astro';

interface Props {
    kicker: string;
    title: string;
    lede: string;
    japanese?: string;
    backHref: string;
    backLabel: string;
}

const { kicker, title, lede, japanese, backHref, backLabel } = Astro.props;
---

<header class="guide-header">
    <a class="guide-header__back" href={backHref}>
        <ArrowLeft size={15} stroke-width={1.9} aria-hidden="true" />
        <span>{backLabel}</span>
    </a>
    <div class="guide-header__copy">
        <p class="guide-header__kicker">{kicker}</p>
        {japanese && <p class="guide-header__japanese" lang="ja">{japanese}</p>}
        <h1>{title}</h1>
        <p class="guide-header__lede">{lede}</p>
    </div>
</header>
