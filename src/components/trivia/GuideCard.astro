---
import { ArrowRight, ExternalLink } from '@lucide/astro';

interface Props {
    title: string;
    body: string;
    kicker: string;
    japanese?: string;
    meta?: string;
    href?: string;
    source?: string;
    search?: string;
    area?: string;
}

const {
    title,
    body,
    kicker,
    japanese,
    meta,
    href,
    source,
    search = '',
    area = '',
} = Astro.props;
---

<article
    class="guide-card"
    data-guide-card
    data-search={search}
    data-area={area}
>
    <p class="guide-card__kicker">{kicker}</p>
    {japanese && <p class="guide-card__japanese" lang="ja">{japanese}</p>}
    <h2 class="guide-card__title">{title}</h2>
    {meta && <p class="guide-card__meta">{meta}</p>}
    <p class="guide-card__body">{body}</p>
    <div class="guide-card__actions">
        {href && (
            <a class="guide-card__link" href={href}>
                <span>Open entry</span>
                <ArrowRight size={14} stroke-width={1.9} aria-hidden="true" />
            </a>
        )}
        {source && !href && (
            <a class="guide-card__source" href={source}>
                <span>Source</span>
                <ExternalLink size={13} stroke-width={1.9} aria-hidden="true" />
            </a>
        )}
    </div>
</article>
