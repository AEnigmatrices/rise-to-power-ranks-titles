---
import { sitePath } from '../../lib/routes';

interface Props {
    rankRecords: number;
    rankEntries: number;
    titleRecords: number;
    titleEntries: number;
}

const { rankRecords, rankEntries, titleRecords, titleEntries } = Astro.props;
---

<header class="hero">
    <div class="hero__ornament hero__ornament--left" aria-hidden="true">天</div>
    <div class="hero__ornament hero__ornament--right" aria-hidden="true">創</div>

    <div class="hero__content">
        <p class="hero__eyebrow">Nobunaga's Ambition · Rise to Power</p>
        <p class="hero__japanese" lang="ja">信長の野望・天下創世</p>
        <h1>Ranks <span>&</span> Titles</h1>
        <p class="hero__lede">
            <em>Tenka Sōsei</em> models two overlapping traditions of authority:
            Imperial Court <strong>Ranks</strong> that raise Politics and Shogunate
            <strong>Titles</strong> that raise Leadership.
        </p>

        <div class="hero__facts" aria-label="Reference totals">
            <div class="hero__fact">
                <span class="hero__fact-value">{rankRecords}</span>
                <span class="hero__fact-label">Rank records</span>
                <span class="hero__fact-detail">{rankEntries} unique entries</span>
            </div>
            <div class="hero__divider" aria-hidden="true"></div>
            <div class="hero__fact">
                <span class="hero__fact-value">{titleRecords}</span>
                <span class="hero__fact-label">Title records</span>
                <span class="hero__fact-detail">{titleEntries} unique entries</span>
            </div>
        </div>

        <nav class="hero__nav" aria-label="Explore the site">
            <a href={sitePath('reference/')}>Browse the reference <span aria-hidden="true">→</span></a>
            <a href={sitePath('trivia/context/')}>Political context <span aria-hidden="true">→</span></a>
            <a href={sitePath('trivia/')}>Historical Guide <span aria-hidden="true">→</span></a>
        </nav>
    </div>
</header>
