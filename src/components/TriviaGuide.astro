---
import { featuredTrivia, getEntryTrivia, officeTrivia } from '../data/trivia';
import { provinces, regions } from '../data/regions';
import { ranks } from '../data/ranks';
import { titles } from '../data/titles';
import { getPronunciation } from '../data/pronunciations';

const appointments = [
    ...ranks.map((entry) => ({ entry, notes: getEntryTrivia(entry, 'rank') })),
    ...titles.map((entry) => ({ entry, notes: getEntryTrivia(entry, 'title') })),
];

const cards = [
    ...featuredTrivia.map((item, index) => ({
        id: `highlight-${index}`, topic: 'highlights', area: '', location: '', search: '',
        ...item,
    })),
    ...regions.map((region) => ({
        id: `region-${region.id}`, topic: 'regions', area: region.area,
        kicker: `${region.type} · ${region.area}`, japanese: region.japanese,
        title: region.name, location: region.location, body: region.body,
        source: region.source, search: region.aliases?.join(' ') ?? '',
    })),
    ...officeTrivia.map((item) => {
        const related = appointments.filter(({ notes }) => notes.some((note) => note.id === item.id));
        return {
            id: `office-${item.id}`, topic: 'offices', area: '', location: '',
            kicker: 'Offices & titles', title: item.label, body: item.body, source: item.source,
            japanese: [...new Set(related.map(({ entry }) => entry.japanese))].slice(0, 3).join('・'),
            search: related.map(({ entry }) => `${entry.name} ${entry.japanese} ${getPronunciation(entry.japanese)}`).join(' '),
        };
    }),
];

const topics = [
    { id: 'highlights', label: 'Highlights', count: featuredTrivia.length },
    { id: 'regions', label: 'Regions & provinces', count: regions.length },
    { id: 'offices', label: 'Offices & titles', count: officeTrivia.length },
    { id: 'all', label: 'All trivia', count: cards.length },
];
const areas = [...new Set(regions.map((region) => region.area))];
---

<section id="trivia" class="trivia-guide" aria-labelledby="trivia-guide-heading" data-trivia-guide>
    <div class="trivia-guide__heading">
        <div>
            <p class="section-kicker">Historical trivia</p>
            <h2 id="trivia-guide-heading">The stories behind the names</h2>
        </div>
        <p>
            Meet the places, people, and institutions behind the appointments.
            Explore {provinces.length} historic provinces and the wider regions named in the tables,
            or follow the <span class="trivia-guide__spark" aria-hidden="true">✦</span>
            markers beside individual offices for a quick note.
        </p>
    </div>

    <div id="regions"></div>
    <div class="trivia-guide__controls" data-trivia-controls hidden>
        <div class="trivia-topics" role="group" aria-label="Trivia topic">
            {topics.map((topic) => (
                <button type="button" class="trivia-topic" data-trivia-topic={topic.id} aria-pressed="false" aria-controls="trivia-cards">
                    {topic.label} <span>{topic.count}</span>
                </button>
            ))}
        </div>
        <div class="trivia-toolbar">
            <div class="field">
                <label class="sr-only" for="trivia-search">Search trivia in the selected topic</label>
                <input id="trivia-search" type="search" autocomplete="off" placeholder="Search this topic by name, place, or story…" data-trivia-search />
            </div>
            <div class="field" data-trivia-area-field hidden>
                <label class="sr-only" for="trivia-area">Filter regions by area</label>
                <select id="trivia-area" data-trivia-area>
                    <option value="">All areas</option>
                    {areas.map((area) => <option value={area}>{area}</option>)}
                </select>
            </div>
            <button class="reset-button" type="button" data-trivia-reset>Reset</button>
        </div>
        <p class="trivia-guide__context" data-region-context hidden>
            Modern locations are approximate. The area groups help you browse; they are not the old administrative circuits.
            Mutsu / Ōshū and Dewa / Ushū use their broad historical extent.
        </p>
        <p class="trivia-guide__count" data-trivia-count role="status" aria-live="polite" aria-atomic="true"></p>
    </div>

    <div id="trivia-cards" class="trivia-grid">
        {
            cards.map((item, index) => (
                <article class="trivia-card" data-trivia-card data-topic={item.topic} data-area={item.area}
                    data-search-title={item.title}
                    data-search-text={[item.title, item.japanese, item.kicker, item.location, item.body, item.search].join(' ')}>
                    <span class="trivia-card__number" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="trivia-card__copy">
                        <p class="trivia-card__kicker">{item.kicker}</p>
                        <p class="trivia-card__japanese" lang="ja">{item.japanese}</p>
                        <h3>{item.title}</h3>
                        {item.location && <p class="trivia-card__location">{item.location}</p>}
                        <p class="trivia-card__body">{item.body}</p>
                        {item.source && <a class="trivia-card__source" href={item.source}>Read more<span class="sr-only"> about {item.title}</span> <span aria-hidden="true">↗</span></a>}
                    </div>
                </article>
            ))
        }
    </div>

    <div class="trivia-guide__empty" data-trivia-empty hidden>
        <p>No trivia matches these filters.</p>
        <p>Try another name, choose a different topic, or reset your search.</p>
    </div>
    <button class="trivia-guide__more reset-button" type="button" data-trivia-more hidden>Show more trivia</button>
</section>

<script>
    const root = document.querySelector<HTMLElement>('[data-trivia-guide]');
    if (root) {
        const controls = root.querySelector<HTMLElement>('[data-trivia-controls]')!;
        const search = root.querySelector<HTMLInputElement>('[data-trivia-search]')!;
        const area = root.querySelector<HTMLSelectElement>('[data-trivia-area]')!;
        const areaField = root.querySelector<HTMLElement>('[data-trivia-area-field]')!;
        const context = root.querySelector<HTMLElement>('[data-region-context]')!;
        const count = root.querySelector<HTMLElement>('[data-trivia-count]')!;
        const empty = root.querySelector<HTMLElement>('[data-trivia-empty]')!;
        const more = root.querySelector<HTMLButtonElement>('[data-trivia-more]')!;
        const cards = [...root.querySelectorAll<HTMLElement>('[data-trivia-card]')];
        const topics = [...root.querySelectorAll<HTMLButtonElement>('[data-trivia-topic]')];
        const pageSize = 6;
        let limit = pageSize;
        let topic = location.hash === '#regions' ? 'regions' : 'highlights';

        // Match plain romanization (Omi, Kyushu) as well as macrons and Japanese.
        const normalize = (value: string) => value.normalize('NFKD')
            .replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        const searchIndex = new Map(cards.map((card) => [card, {
            text: normalize(card.dataset.searchText ?? ''),
            title: normalize(card.dataset.searchTitle ?? ''),
        }]));

        const update = () => {
            const query = normalize(search.value);
            const terms = query.split(/\s+/).filter(Boolean);
            const matches = cards.filter((card) =>
                (topic === 'all' || card.dataset.topic === topic) &&
                (topic !== 'regions' || !area.value || card.dataset.area === area.value) &&
                terms.every((term) => searchIndex.get(card)!.text.includes(term)),
            ).sort((a, b) => Number(searchIndex.get(b)!.title.startsWith(query)) - Number(searchIndex.get(a)!.title.startsWith(query)));
            const visible = new Set(matches.slice(0, limit));
            cards.forEach((card) => { card.hidden = !visible.has(card); });
            // Keep visual and keyboard order aligned with the most relevant names first.
            const grid = root.querySelector('#trivia-cards')!;
            matches.forEach((card) => grid.append(card));
            topics.forEach((button) => {
                button.setAttribute('aria-pressed', String(button.dataset.triviaTopic === topic));
            });
            areaField.hidden = topic !== 'regions';
            context.hidden = topic !== 'regions' && topic !== 'all';
            empty.hidden = matches.length > 0;
            more.hidden = matches.length <= limit;
            more.textContent = `Show ${Math.min(pageSize, Math.max(0, matches.length - limit))} more`;
            const noun = topic === 'regions' ? 'place' : 'note';
            count.textContent = `Showing ${visible.size} of ${matches.length} ${noun}${matches.length === 1 ? '' : 's'}`;
        };
        const filter = () => { limit = pageSize; update(); };
        topics.forEach((button) => button.addEventListener('click', () => {
            topic = button.dataset.triviaTopic!;
            history.replaceState(null, '', topic === 'regions' ? '#regions' : '#trivia');
            filter();
        }));
        search.addEventListener('input', filter);
        area.addEventListener('change', filter);
        root.querySelector('[data-trivia-reset]')!.addEventListener('click', () => {
            search.value = '';
            area.value = '';
            filter();
            search.focus();
        });
        more.addEventListener('click', () => {
            const previouslyVisible = new Set(cards.filter((card) => !card.hidden));
            limit += pageSize;
            update();
            // Keep keyboard users at the start of the newly revealed notes.
            const firstNew = [...root.querySelectorAll<HTMLElement>('[data-trivia-card]')]
                .find((card) => !card.hidden && !previouslyVisible.has(card));
            if (firstNew) {
                firstNew.tabIndex = -1;
                firstNew.focus({ preventScroll: true });
            }
        });
        const followHash = () => {
            if (location.hash !== '#regions' && location.hash !== '#trivia') return;
            topic = location.hash === '#regions' ? 'regions' : 'highlights';
            search.value = '';
            area.value = '';
            filter();
        };
        window.addEventListener('hashchange', followHash);
        controls.hidden = false;
        update();
    }
</script>
