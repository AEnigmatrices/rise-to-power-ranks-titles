---
import { ArrowRight } from '@lucide/astro';
import { sitePath } from '../../lib/routes';
---

<section class="systems" aria-labelledby="systems-heading">
    <div class="systems__heading">
        <p class="section-kicker">Two parallel systems</p>
        <h2 id="systems-heading">One officer can hold both.</h2>
        <p>
            Ranks and Titles are not stages on one ladder. They represent recognition
            from different institutions that continued to overlap in Sengoku Japan.
        </p>
        <a class="systems__more" href={sitePath('trivia/context/')}>
            <span>Why did both systems exist?</span>
            <ArrowRight size={14} stroke-width={1.9} aria-hidden="true" />
        </a>
    </div>

    <div class="systems__cards">
        <article class="system-card system-card--rank">
            <div class="system-card__seal" aria-hidden="true">官</div>
            <div>
                <p class="system-card__type">Imperial Court</p>
                <h3>Ranks</h3>
                <p>
                    Court ranks, offices, and provincial governorships inherited from
                    the older imperial order.
                </p>
            </div>
            <div class="system-card__effect">
                <span class="effect-chip effect-chip--politics">POL</span>
                <span>Politics +1 → +12</span>
            </div>
        </article>

        <article class="system-card system-card--title">
            <div class="system-card__seal" aria-hidden="true">将</div>
            <div>
                <p class="system-card__type">Muromachi Shogunate</p>
                <h3>Titles</h3>
                <p>
                    Shogunate offices and Shugo appointments associated with the
                    warrior government.
                </p>
            </div>
            <div class="system-card__effect">
                <span class="effect-chip effect-chip--leadership">LDR</span>
                <span>Leadership +2 → +12</span>
            </div>
        </article>
    </div>
</section>
