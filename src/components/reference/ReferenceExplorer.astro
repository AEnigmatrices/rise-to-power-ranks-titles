---
import { RotateCcw, Search, Sparkles, X } from '@lucide/astro';
import { rankAppointments, titleAppointments } from '../../data/appointments';
import { getNotableHolders } from '../../data/holders';
import type { TriviaItem } from '../../data/schema/trivia';
import { getEntryTrivia } from '../../lib/trivia';
import { sitePath } from '../../lib/routes';
import { getSourceLabel } from '../../lib/sources';
import {
    toReferenceEntries,
    totalRecords,
    type ReferenceEntry,
    type ReferenceKind,
} from '../../lib/appointments';

const ranks = toReferenceEntries(rankAppointments);
const titles = toReferenceEntries(titleAppointments);

type ReferenceGroup = {
    className: string;
    bonus: number;
    entries: ReferenceEntry[];
};

const groupEntries = (entries: ReferenceEntry[]): ReferenceGroup[] => {
    const groups = new Map<string, ReferenceGroup>();

    entries.forEach((entry) => {
        const existing = groups.get(entry.className);
        if (existing) {
            existing.entries.push(entry);
            return;
        }

        groups.set(entry.className, {
            className: entry.className,
            bonus: entry.bonus,
            entries: [entry],
        });
    });

    return [...groups.values()];
};

const groupsByKind: Record<ReferenceKind, ReferenceGroup[]> = {
    rank: groupEntries(ranks),
    title: groupEntries(titles),
};

const triviaHref = (item: TriviaItem) =>
    item.id.startsWith('region-')
        ? sitePath(`trivia/regions/${item.id.slice('region-'.length)}/`)
        : sitePath(`trivia/offices/${item.id}/`);

const searchableText = (
    entry: ReferenceEntry,
    trivia: TriviaItem[],
    holders = getNotableHolders(entry.id),
) =>
    [
        entry.gameName,
        entry.japanese,
        entry.reading,
        entry.meaning,
        entry.className,
        entry.effect,
        entry.categoryLabel,
        ...trivia.flatMap((item) => [item.label, item.body]),
        ...holders.flatMap((holder) => [holder.name, holder.japanese ?? '', holder.description]),
    ].join(' ');
---

<section id="reference" class="explorer" aria-labelledby="explorer-heading" data-reference-explorer>
    <h2 id="explorer-heading" class="sr-only">
        Browse every appointment
    </h2>
    <p class="sr-only" id="reference-search-help">
        Search English or Japanese names, readings, and historical meanings in the selected system.
    </p>

    <div class="switcher" role="tablist" aria-label="Appointment system">
        <button
            class="switcher__tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="rank-panel"
            id="rank-tab"
            data-view="rank"
        >
            <span class="switcher__mark" aria-hidden="true">
                官
            </span>
            <span class="switcher__copy">
                <strong>Imperial Court Ranks</strong>
                <small>
                    {ranks.length} appointments{' '}
                    <span class="switcher__occurrences">· {totalRecords(ranks)} occurrences</span>
                </small>
            </span>
            <span class="effect-chip effect-chip--politics">Politics ↑</span>
        </button>

        <button
            class="switcher__tab"
            type="button"
            role="tab"
            aria-selected="false"
            tabindex="-1"
            aria-controls="title-panel"
            id="title-tab"
            data-view="title"
        >
            <span class="switcher__mark" aria-hidden="true">
                将
            </span>
            <span class="switcher__copy">
                <strong>Shogunate Titles</strong>
                <small>
                    {titles.length} appointments{' '}
                    <span class="switcher__occurrences">· {totalRecords(titles)} occurrences</span>
                </small>
            </span>
            <span class="effect-chip effect-chip--leadership">Leadership ↑</span>
        </button>
    </div>

    <div class="toolbar">
        <div class="toolbar__search field">
            <label class="control-label" for="reference-search">
                Search appointments
            </label>
            <div class="control-input">
                <Search class="field__icon" size={18} stroke-width={1.8} aria-hidden="true" />
                <input
                    id="reference-search"
                    type="search"
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="reference-search-help"
                    placeholder="Name, office, or meaning…"
                    data-search
                />
                <button
                    class="control-clear"
                    type="button"
                    aria-label="Clear appointment search"
                    data-search-clear
                    hidden
                >
                    <X size={15} stroke-width={2} aria-hidden="true" />
                </button>
                <kbd aria-hidden="true" data-search-shortcut>
                    /
                </kbd>
            </div>
        </div>

        <div class="field">
            <label class="control-label" for="class-filter">
                Filter by class
            </label>
            <select id="class-filter" data-class-filter>
                <option value="">All classes</option>
            </select>
        </div>

        <div class="field">
            <label class="control-label" for="category-filter">
                Filter by type
            </label>
            <select id="category-filter" data-category-filter>
                <option value="">All office types</option>
            </select>
        </div>

        <button
            class="reset-button reset-button--icon"
            type="button"
            aria-label="Reset filters"
            title="Reset search and filters"
            data-reset
        >
            <RotateCcw size={15} stroke-width={1.9} aria-hidden="true" />
            <span>Reset</span>
        </button>
    </div>

    <div class="results-line">
        <p data-result-count role="status" aria-atomic="true">
            {ranks.length} unique ranks · {totalRecords(ranks)} occurrences
        </p>
        <p class="results-line__hint">
            <strong>×N</strong> marks repeated source occurrences · Press <kbd>/</kbd> to search
        </p>
    </div>

    <details class="explorer__help">
        <summary>How to read this reference</summary>
        <div class="explorer__help-copy">
            <p>
                <strong>Ranks and Titles:</strong> choose a system above, then search or filter its
                appointments. Ranks raise Politics; Titles raise Leadership.
            </p>
            <p>
                <strong>Historical context:</strong> “Rank” is the game category. Historically,
                personal court rank (<span lang="ja">位階</span>) and court office (
                <span lang="ja">官職</span>) were distinct.
            </p>
            <p>
                <Sparkles size={14} aria-hidden="true" /> opens a historical note.{' '}
                <strong>×N</strong> shows repeated source occurrences. Use <strong>#</strong> to
                link to an appointment.
            </p>
        </div>
    </details>

    {(Object.entries(groupsByKind) as [ReferenceKind, ReferenceGroup[]][]).map(([kind, groups]) => (
        <section
            class="reference-panel"
            id={`${kind}-panel`}
            role="tabpanel"
            aria-labelledby={`${kind}-tab`}
            data-panel={kind}
            hidden={kind !== 'rank'}
        >
            <div class="table-shell">
                <div class="reference-ledger__columns" aria-hidden="true">
                    <span>Appointment</span>
                    <span>Japanese office</span>
                    <span>Historical meaning</span>
                </div>
                <table class="reference-table">
                    <caption>
                        {kind === 'rank'
                            ? 'Imperial Court ranks in Nobunaga’s Ambition: Rise to Power'
                            : 'Shogunate titles in Nobunaga’s Ambition: Rise to Power'}
                    </caption>
                    <thead class="sr-only">
                        <tr>
                            <th scope="col">Appointment</th>
                            <th scope="col">Japanese office</th>
                            <th scope="col">Historical meaning</th>
                        </tr>
                    </thead>

                    {groups.map((group) => {
                        const groupRecords = totalRecords(group.entries);
                        const stat = kind === 'rank' ? 'Politics' : 'Leadership';

                        return (
                            <tbody
                                class="reference-group"
                                data-reference-group
                                data-class={group.className}
                            >
                                <tr class="reference-group__heading">
                                    <th colspan="3" scope="rowgroup">
                                        <span class="reference-group__title">
                                            <span>{group.className}</span>
                                            <span
                                                class:list={[
                                                    'reference-group__effect',
                                                    kind === 'rank'
                                                        ? 'reference-group__effect--politics'
                                                        : 'reference-group__effect--leadership',
                                                ]}
                                            >
                                                {stat} +{group.bonus}
                                            </span>
                                        </span>
                                        <span class="reference-group__count">
                                            {group.entries.length}{' '}
                                            {group.entries.length === 1
                                                ? 'appointment'
                                                : 'appointments'}
                                            {groupRecords !== group.entries.length && (
                                                <> · {groupRecords} occurrences</>
                                            )}
                                        </span>
                                    </th>
                                </tr>

                                {group.entries.map((entry, index) => {
                                    const pronunciation = entry.reading;
                                    const trivia = getEntryTrivia(entry);
                                    const holders = getNotableHolders(entry.id);
                                    const triviaId = `trivia-${entry.id}`;

                                    return (
                                        <tr
                                            id={entry.id}
                                            data-reference-row
                                            data-kind={kind}
                                            data-class={entry.className}
                                            data-category={entry.categoryLabel}
                                            data-bonus={entry.bonus}
                                            data-count={entry.count}
                                            data-order={entry.sourceOrder ?? index}
                                            data-search-name={entry.gameName}
                                            data-search-japanese={entry.japanese}
                                            data-search-pronunciation={pronunciation}
                                            data-search-translation={entry.meaning}
                                            data-search-text={searchableText(
                                                entry,
                                                trivia,
                                                holders,
                                            )}
                                            class:list={[
                                                entry.category === 'shugo' && 'is-shugo',
                                                entry.category === 'provincial-office' &&
                                                    'is-provincial',
                                            ]}
                                        >
                                            <td data-label="Appointment" class="name-cell">
                                                <span class="entry-name-line">
                                                    <span class="entry-name">{entry.gameName}</span>
                                                    <a
                                                        class="entry-permalink"
                                                        href={`#${entry.id}`}
                                                        aria-label={`Link to ${entry.gameName}`}
                                                    >
                                                        #
                                                    </a>
                                                </span>
                                                <span class="entry-meta">
                                                    <span class="entry-type">
                                                        {entry.categoryLabel}
                                                    </span>
                                                    {entry.count > 1 && (
                                                        <span
                                                            class="count-badge count-badge--multiple"
                                                            aria-label={`${entry.count} occurrences in the source data`}
                                                        >
                                                            ×{entry.count}
                                                        </span>
                                                    )}
                                                </span>
                                                <span class="entry-mobile-meta" aria-hidden="true">
                                                    <span>{entry.className}</span>
                                                    <span>·</span>
                                                    <span>
                                                        {stat} +{entry.bonus}
                                                    </span>
                                                </span>
                                            </td>

                                            <td data-label="Japanese office" class="japanese">
                                                <span class="japanese__main">
                                                    <span class="japanese__line">
                                                        <span lang="ja">{entry.japanese}</span>
                                                        {trivia.length > 0 && (
                                                            <span
                                                                class="trivia-anchor"
                                                                data-trivia-anchor
                                                            >
                                                                <button
                                                                    class="trivia-trigger"
                                                                    type="button"
                                                                    aria-expanded="false"
                                                                    aria-controls={triviaId}
                                                                    data-trivia-trigger
                                                                >
                                                                    <Sparkles
                                                                        size={12}
                                                                        stroke-width={2.15}
                                                                        aria-hidden="true"
                                                                    />
                                                                    <span class="sr-only">
                                                                        Historical trivia about{' '}
                                                                        {entry.japanese}
                                                                    </span>
                                                                </button>
                                                                <span
                                                                    class="trivia-popover"
                                                                    id={triviaId}
                                                                    role="dialog"
                                                                    aria-label={`Historical context for ${entry.japanese}`}
                                                                    data-trivia-popover
                                                                    data-placement="below"
                                                                >
                                                                    <span class="trivia-popover__eyebrow">
                                                                        Historical context
                                                                    </span>
                                                                    <button
                                                                        class="trivia-popover__close"
                                                                        type="button"
                                                                        aria-label="Close historical note"
                                                                        data-trivia-close
                                                                    >
                                                                        <X
                                                                            size={16}
                                                                            aria-hidden="true"
                                                                        />
                                                                    </button>
                                                                    {trivia.map((item) => (
                                                                        <span class="trivia-popover__item">
                                                                            <strong>
                                                                                {item.label}
                                                                            </strong>
                                                                            <span>{item.body}</span>
                                                                            <a
                                                                                class="trivia-popover__more"
                                                                                href={triviaHref(
                                                                                    item,
                                                                                )}
                                                                            >
                                                                                Open full historical
                                                                                note →
                                                                            </a>
                                                                        </span>
                                                                    ))}
                                                                    <span class="trivia-popover__hint">
                                                                        Tap outside or press Esc to
                                                                        close.
                                                                    </span>
                                                                </span>
                                                            </span>
                                                        )}
                                                    </span>
                                                    <span class="pronunciation">
                                                        {pronunciation}
                                                    </span>
                                                </span>
                                            </td>

                                            <td data-label="Historical meaning" class="translation">
                                                <span class="translation__meaning">
                                                    {entry.meaning}
                                                </span>
                                                {holders.length > 0 && (
                                                    <details class="holder-details">
                                                        <summary>
                                                            Notable{' '}
                                                            {holders.length === 1
                                                                ? 'holder'
                                                                : 'holders'}
                                                        </summary>
                                                        <span class="holder-details__list">
                                                            {holders.map((holder) => (
                                                                <span class="holder-details__item">
                                                                    <span class="holder-details__name">
                                                                        <strong>
                                                                            {holder.name}
                                                                        </strong>
                                                                        {holder.japanese && (
                                                                            <span lang="ja">
                                                                                {holder.japanese}
                                                                            </span>
                                                                        )}
                                                                    </span>
                                                                    <span>
                                                                        {holder.description}
                                                                    </span>
                                                                    <span class="holder-details__sources">
                                                                        {holder.sources.map(
                                                                            (source) => (
                                                                                <a
                                                                                    href={
                                                                                        source.url
                                                                                    }
                                                                                >
                                                                                    {getSourceLabel(
                                                                                        source,
                                                                                    )}{' '}
                                                                                    →
                                                                                </a>
                                                                            ),
                                                                        )}
                                                                    </span>
                                                                </span>
                                                            ))}
                                                        </span>
                                                    </details>
                                                )}
                                            </td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        );
                    })}
                </table>

                <div class="empty-state" data-empty hidden>
                    <span class="empty-state__mark" aria-hidden="true">
                        無
                    </span>
                    <strong>No matching appointments</strong>
                    <p>Try another search term or loosen one of the filters.</p>
                    <button class="reset-button" type="button" data-reset>
                        Clear search &amp; filters
                    </button>
                </div>
            </div>
        </section>
    ))}
</section>

<script>
    import '../../scripts/reference-explorer';
</script>
