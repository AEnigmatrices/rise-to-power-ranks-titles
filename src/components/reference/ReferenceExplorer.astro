---
import { RotateCcw, Search, Sparkles, X } from '@lucide/astro';
import { rankAppointments, titleAppointments } from '../../data/appointments';
import type { TriviaItem } from '../../data/schema/trivia';
import { getEntryTrivia } from '../../lib/trivia';
import { sitePath } from '../../lib/routes';
import {
    toReferenceEntries,
    totalRecords,
    type ReferenceEntry,
    type ReferenceKind,
} from '../../lib/appointments';

const ranks = toReferenceEntries(rankAppointments);
const titles = toReferenceEntries(titleAppointments);

const rowsByKind: Record<ReferenceKind, ReferenceEntry[]> = {
    rank: ranks,
    title: titles,
};

const triviaHref = (item: TriviaItem) =>
    item.id.startsWith('region-')
        ? sitePath(`trivia/regions/${item.id.slice('region-'.length)}/`)
        : sitePath(`trivia/offices/${item.id}/`);

const searchableText = (entry: ReferenceEntry, trivia: TriviaItem[]) =>
    [
        entry.gameName,
        entry.japanese,
        entry.reading,
        entry.meaning,
        entry.className,
        entry.effect,
        entry.categoryLabel,
        ...trivia.flatMap((item) => [item.label, item.body]),
    ].join(' ');
---

<section id="reference" class="explorer" aria-labelledby="explorer-heading" data-reference-explorer>
    <h2 id="explorer-heading" class="sr-only">
        Browse every appointment
    </h2>
    <p class="explorer__legend" id="reference-search-help">
        Search English or Japanese names, readings, and historical meanings.
        <span>
            <strong>“Rank” is the game category:</strong> historically, personal court rank
            (位階) and court office (官職) were distinct.
        </span>
        <span>
            <Sparkles size={12} stroke-width={2} aria-hidden="true" /> opens a historical note.
        </span>
    </p>

    <div class="switcher" role="tablist" aria-label="Appointment system">
        <button
            class="switcher__tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="rank-panel"
            id="rank-tab"
            data-view="rank"
        >
            <span class="switcher__mark" aria-hidden="true">
                官
            </span>
            <span class="switcher__copy">
                <strong>Imperial Court Ranks</strong>
                <small>
                    {ranks.length} unique · {totalRecords(ranks)} occurrences
                </small>
            </span>
            <span class="effect-chip effect-chip--politics">Politics ↑</span>
        </button>

        <button
            class="switcher__tab"
            type="button"
            role="tab"
            aria-selected="false"
            tabindex="-1"
            aria-controls="title-panel"
            id="title-tab"
            data-view="title"
        >
            <span class="switcher__mark" aria-hidden="true">
                将
            </span>
            <span class="switcher__copy">
                <strong>Shogunate Titles</strong>
                <small>
                    {titles.length} unique · {totalRecords(titles)} occurrences
                </small>
            </span>
            <span class="effect-chip effect-chip--leadership">Leadership ↑</span>
        </button>
    </div>

    <div class="toolbar">
        <div class="toolbar__search field">
            <label class="control-label" for="reference-search">
                Search appointments
            </label>
            <div class="control-input">
                <Search class="field__icon" size={18} stroke-width={1.8} aria-hidden="true" />
                <input
                    id="reference-search"
                    type="search"
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="reference-search-help"
                    placeholder="Name, Japanese office, or meaning…"
                    data-search
                />
                <kbd aria-hidden="true">/</kbd>
            </div>
        </div>

        <div class="field">
            <label class="control-label" for="class-filter">
                Filter by class
            </label>
            <select id="class-filter" data-class-filter>
                <option value="">All classes</option>
            </select>
        </div>

        <div class="field">
            <label class="control-label" for="category-filter">
                Filter by type
            </label>
            <select id="category-filter" data-category-filter>
                <option value="">All office types</option>
            </select>
        </div>

        <button class="reset-button reset-button--icon" type="button" data-reset>
            <RotateCcw size={15} stroke-width={1.9} aria-hidden="true" />
            <span>Reset</span>
        </button>
    </div>

    <div class="results-line">
        <p data-result-count role="status" aria-atomic="true">
            {ranks.length} unique ranks · {totalRecords(ranks)} occurrences
        </p>
        <p class="results-line__hint">
            Press <kbd>/</kbd> to search · <kbd>Esc</kbd> to clear
        </p>
    </div>

    {(Object.entries(rowsByKind) as [ReferenceKind, ReferenceEntry[]][]).map(([kind, entries]) => (
        <section
            class="reference-panel"
            id={`${kind}-panel`}
            role="tabpanel"
            aria-labelledby={`${kind}-tab`}
            data-panel={kind}
            hidden={kind !== 'rank'}
        >
            <div class="table-shell">
                <table class="reference-table">
                    <caption>
                        {kind === 'rank'
                            ? 'Imperial Court ranks in Nobunaga’s Ambition: Rise to Power'
                            : 'Shogunate titles in Nobunaga’s Ambition: Rise to Power'}
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Class</th>
                            <th scope="col">Game name</th>
                            <th scope="col">Japanese office</th>
                            <th scope="col">Historical meaning</th>
                            <th scope="col">Effect</th>
                            <th scope="col" class="count-heading">
                                Occurrences
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {entries.map((entry, index) => {
                            const pronunciation = entry.reading;
                            const trivia = getEntryTrivia(entry);
                            const triviaId = `trivia-${entry.id}`;

                            return (
                                <tr
                                    id={entry.id}
                                    data-reference-row
                                    data-kind={kind}
                                    data-class={entry.className}
                                    data-category={entry.categoryLabel}
                                    data-bonus={entry.bonus}
                                    data-count={entry.count}
                                    data-order={index}
                                    data-search-name={entry.gameName}
                                    data-search-japanese={entry.japanese}
                                    data-search-pronunciation={pronunciation}
                                    data-search-translation={entry.meaning}
                                    data-search-text={searchableText(entry, trivia)}
                                    class:list={[
                                        entry.category === 'shugo' && 'is-shugo',
                                        entry.category === 'provincial-office' && 'is-provincial',
                                    ]}
                                >
                                    <td data-label="Class" class="class-cell">
                                        <span
                                            class:list={[
                                                'class-chip',
                                                entry.className.startsWith('Upper')
                                                    ? 'class-chip--upper'
                                                    : 'class-chip--lower',
                                            ]}
                                        >
                                            {entry.className}
                                        </span>
                                    </td>
                                    <td data-label="Game name" class="name-cell">
                                        <span class="entry-name-line">
                                            <span class="entry-name">{entry.gameName}</span>
                                            <a
                                                class="entry-permalink"
                                                href={`#${entry.id}`}
                                                aria-label={`Link to ${entry.gameName}`}
                                            >
                                                #
                                            </a>
                                        </span>
                                        <span class="entry-type">{entry.categoryLabel}</span>
                                    </td>
                                    <td data-label="Japanese office" class="japanese">
                                        <span class="japanese__main">
                                            <span class="japanese__line">
                                                <span lang="ja">{entry.japanese}</span>
                                                {trivia.length > 0 && (
                                                    <span class="trivia-anchor" data-trivia-anchor>
                                                        <button
                                                            class="trivia-trigger"
                                                            type="button"
                                                            aria-expanded="false"
                                                            aria-controls={triviaId}
                                                            data-trivia-trigger
                                                        >
                                                            <Sparkles
                                                                size={12}
                                                                stroke-width={2.15}
                                                                aria-hidden="true"
                                                            />
                                                            <span class="sr-only">
                                                                Historical trivia about{' '}
                                                                {entry.japanese}
                                                            </span>
                                                        </button>
                                                        <span
                                                            class="trivia-popover"
                                                            id={triviaId}
                                                            role="dialog"
                                                            aria-label={`Historical context for ${entry.japanese}`}
                                                            data-trivia-popover
                                                            data-placement="below"
                                                        >
                                                            <span class="trivia-popover__eyebrow">
                                                                Historical context
                                                            </span>
                                                            <button
                                                                class="trivia-popover__close"
                                                                type="button"
                                                                aria-label="Close historical note"
                                                                data-trivia-close
                                                            >
                                                                <X size={16} aria-hidden="true" />
                                                            </button>
                                                            {trivia.map((item) => (
                                                                <span class="trivia-popover__item">
                                                                    <strong>{item.label}</strong>
                                                                    <span>{item.body}</span>
                                                                    <a
                                                                        class="trivia-popover__more"
                                                                        href={triviaHref(item)}
                                                                    >
                                                                        Open full historical note →
                                                                    </a>
                                                                </span>
                                                            ))}
                                                            <span class="trivia-popover__hint">
                                                                Tap outside or press Esc to close.
                                                            </span>
                                                        </span>
                                                    </span>
                                                )}
                                            </span>
                                            <span class="pronunciation">{pronunciation}</span>
                                        </span>
                                    </td>
                                    <td data-label="Historical meaning" class="translation">
                                        {entry.meaning}
                                    </td>
                                    <td data-label="Effect" class="effect-cell">
                                        <span
                                            class:list={[
                                                'effect-value',
                                                kind === 'rank'
                                                    ? 'effect-value--politics'
                                                    : 'effect-value--leadership',
                                            ]}
                                        >
                                            <span class="effect-chip" aria-hidden="true">
                                                {kind === 'rank' ? 'POL' : 'LDR'}
                                            </span>
                                            <span class="sr-only">
                                                {kind === 'rank' ? 'Politics' : 'Leadership'}
                                            </span>
                                            +{entry.bonus}
                                        </span>
                                    </td>
                                    <td data-label="Occurrences" class="count-cell">
                                        <span
                                            class:list={[
                                                'count-badge',
                                                entry.count > 1 && 'count-badge--multiple',
                                            ]}
                                        >
                                            ×{entry.count}
                                        </span>
                                    </td>
                                </tr>
                            );
                        })}
                    </tbody>
                </table>

                <div class="empty-state" data-empty hidden>
                    <span class="empty-state__mark" aria-hidden="true">
                        無
                    </span>
                    <strong>No matching appointments</strong>
                    <p>Try another search term or loosen one of the filters.</p>
                    <button class="reset-button" type="button" data-reset>
                        Clear search &amp; filters
                    </button>
                </div>
            </div>
        </section>
    ))}
</section>

<script>
    import '../../scripts/reference-explorer';
</script>
