---
import { sitePath } from '../../lib/routes';
import GlobalSearch from './GlobalSearch.astro';

interface Props {
    current?: 'home' | 'reference' | 'guide';
}

const { current } = Astro.props;
---

<nav class="section-nav" aria-label="Site navigation" data-pagefind-ignore>
    <a class="section-nav__brand" href={sitePath()}>
        <span>Tenka Sōsei</span>
        <strong>Ranks &amp; Titles</strong>
    </a>
    <div class="section-nav__links">
        <a href={sitePath()} aria-current={current === 'home' ? 'page' : undefined}>Overview</a>
        <a href={sitePath('reference/')} aria-current={current === 'reference' ? 'page' : undefined}>Reference</a>
        <a href={sitePath('trivia/')} aria-current={current === 'guide' ? 'page' : undefined}>
            <span class="section-nav__guide-label section-nav__guide-label--full">Historical Guide</span>
            <span class="section-nav__guide-label section-nav__guide-label--short" aria-hidden="true">Guide</span>
        </a>
        <GlobalSearch />
        <a href="#top" class="section-nav__top">↑ Top</a>
    </div>
</nav>
