---
import { Search, X } from '@lucide/astro';
import { sitePath } from '../../lib/routes';

const pagefindPath = sitePath('pagefind/pagefind.js');
const baseUrl = sitePath();
---

<div class="global-search" data-global-search data-pagefind-ignore>
    <button
        class="global-search__trigger"
        type="button"
        aria-label="Search site"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-keyshortcuts="Control+K Meta+K"
        data-global-search-open
    >
        <Search size={15} stroke-width={1.9} aria-hidden="true" />
        <span>Search</span>
        <kbd aria-hidden="true" data-global-search-shortcut>
            ⌘K
        </kbd>
    </button>

    <dialog
        class="global-search__dialog"
        aria-labelledby="global-search-title"
        data-global-search-dialog
    >
        <div class="global-search__panel">
            <div class="global-search__heading">
                <div>
                    <p class="global-search__eyebrow">Site search</p>
                    <h2 id="global-search-title">Search the reference &amp; historical guide</h2>
                </div>
                <button
                    class="global-search__close"
                    type="button"
                    aria-label="Close site search"
                    data-global-search-close
                >
                    <X size={18} aria-hidden="true" />
                </button>
            </div>

            <label class="global-search__field">
                <Search size={18} stroke-width={1.8} aria-hidden="true" />
                <span class="sr-only">Search the site</span>
                <input
                    type="search"
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="global-search-status"
                    placeholder="Search names, places, or offices…"
                    data-global-search-input
                />
                <button
                    class="global-search__clear"
                    type="button"
                    aria-label="Clear site search"
                    data-global-search-clear
                    hidden
                >
                    <X size={16} aria-hidden="true" />
                </button>
            </label>

            <p
                id="global-search-status"
                class="global-search__status"
                role="status"
                aria-live="polite"
                aria-atomic="true"
                data-global-search-status
            >
                Start typing to search the whole site.
            </p>

            <div class="global-search__suggestions" data-global-search-suggestions>
                <span>Try a search</span>
                {['Shōgun', 'Mutsu', 'Kantō Kanrei'].map((query) => (
                    <button type="button" data-global-search-example={query}>
                        {query}
                    </button>
                ))}
            </div>
            <a
                class="global-search__fallback"
                href={sitePath('reference/')}
                data-global-search-fallback
                hidden
            >
                Browse and filter all appointments <span aria-hidden="true">→</span>
            </a>
            <div class="global-search__results" aria-busy="false" data-global-search-results></div>
            <p class="global-search__keyboard" aria-hidden="true">
                <kbd>↑</kbd> <kbd>↓</kbd> navigate{' '}
                <span>
                    <kbd>Enter</kbd> open
                </span>{' '}
                <span>
                    <kbd>Esc</kbd> close
                </span>
            </p>
        </div>
    </dialog>
</div>

<script define:vars={{ pagefindPath, baseUrl }}>
    const root = document.querySelector('[data-global-search]');
    const dialog = root?.querySelector('[data-global-search-dialog]');
    const openButton = root?.querySelector('[data-global-search-open]');
    const closeButton = root?.querySelector('[data-global-search-close]');
    const input = root?.querySelector('[data-global-search-input]');
    const results = root?.querySelector('[data-global-search-results]');
    const status = root?.querySelector('[data-global-search-status]');
    const shortcut = root?.querySelector('[data-global-search-shortcut]');
    const clearButton = root?.querySelector('[data-global-search-clear]');
    const suggestions = root?.querySelector('[data-global-search-suggestions]');
    const fallback = root?.querySelector('[data-global-search-fallback]');

    if (
        root instanceof HTMLElement &&
        dialog instanceof HTMLDialogElement &&
        openButton instanceof HTMLButtonElement &&
        closeButton instanceof HTMLButtonElement &&
        input instanceof HTMLInputElement &&
        results instanceof HTMLElement &&
        status instanceof HTMLElement
    ) {
        let pagefindPromise;
        let searchRun = 0;
        let returnFocus = null;

        if (shortcut instanceof HTMLElement) {
            const isApplePlatform = /Mac|iPhone|iPad|iPod/i.test(navigator.platform);
            shortcut.textContent = isApplePlatform ? '⌘K' : 'Ctrl K';
        }

        const getPagefind = async () => {
            pagefindPromise ??= import(pagefindPath)
                .then(async (pagefind) => {
                    await pagefind.init();
                    await pagefind.options({
                        baseUrl,
                        excerptLength: 24,
                    });
                    return pagefind;
                })
                .catch((error) => {
                    pagefindPromise = undefined;
                    throw error;
                });
            return pagefindPromise;
        };

        const close = () => {
            if (dialog.open) dialog.close();
        };

        dialog.addEventListener('close', () => {
            openButton.setAttribute('aria-expanded', 'false');
            document.documentElement.classList.remove('has-search-dialog');

            const target = returnFocus instanceof HTMLElement ? returnFocus : openButton;
            target.focus();
            returnFocus = null;
        });

        const open = (invoker = document.activeElement) => {
            if (dialog.open) return;

            returnFocus =
                invoker instanceof HTMLElement && invoker !== document.body ? invoker : openButton;
            dialog.showModal();
            document.documentElement.classList.add('has-search-dialog');
            openButton.setAttribute('aria-expanded', 'true');
            requestAnimationFrame(() => input.focus());
        };

        const renderResults = async () => {
            const query = input.value.trim();
            const run = ++searchRun;

            if (!query) {
                results.replaceChildren();
                results.setAttribute('aria-busy', 'false');
                status.textContent = 'Start typing to search the whole site.';
                return;
            }

            status.textContent = 'Searching…';
            results.setAttribute('aria-busy', 'true');

            try {
                const pagefind = await getPagefind();
                const search = await pagefind.search(query);
                const items = await Promise.all(
                    search.results.slice(0, 8).map((result) => result.data()),
                );

                if (run !== searchRun) return;

                results.replaceChildren();

                if (!items.length) {
                    status.textContent = `No results for “${query}”. Try a shorter name or a different spelling.`;
                    if (fallback) fallback.hidden = false;
                    return;
                }

                status.textContent = `${search.results.length} ${search.results.length === 1 ? 'result' : 'results'} for “${query}”.${search.results.length > items.length ? ` Showing the first ${items.length}.` : ''}`;

                items.forEach((item) => {
                    const link = document.createElement('a');
                    link.className = 'global-search__result';
                    link.href = item.url;

                    const title = document.createElement('strong');
                    title.textContent = item.meta?.title || item.url;

                    const excerpt = document.createElement('span');
                    excerpt.className = 'global-search__excerpt';
                    excerpt.innerHTML = item.excerpt || '';

                    const route = document.createElement('small');
                    const routePath = new URL(item.url, location.href).pathname;
                    route.textContent =
                        '/' + routePath.slice(baseUrl.length).replace(/^\/+|\/+$/g, '');

                    link.append(title, excerpt, route);
                    results.append(link);
                });
            } catch {
                if (run !== searchRun) return;
                results.replaceChildren();
                status.textContent =
                    'Site search is unavailable right now. You can still search appointments in the reference.';
                if (fallback) fallback.hidden = false;
            } finally {
                if (run === searchRun) results.setAttribute('aria-busy', 'false');
            }
        };

        let searchTimer;
        const scheduleSearch = () => {
            window.clearTimeout(searchTimer);
            searchRun++;
            const hasQuery = Boolean(input.value.trim());
            results.replaceChildren();
            results.setAttribute('aria-busy', String(hasQuery));
            if (clearButton) clearButton.hidden = !input.value;
            if (suggestions) suggestions.hidden = hasQuery;
            if (fallback) fallback.hidden = true;
            status.textContent = hasQuery ? 'Searching…' : 'Start typing to search the whole site.';
            if (hasQuery) searchTimer = window.setTimeout(renderResults, 120);
        };

        input.addEventListener('input', scheduleSearch);
        clearButton?.addEventListener('click', () => {
            input.value = '';
            scheduleSearch();
            input.focus();
        });
        root.querySelectorAll('[data-global-search-example]').forEach((button) => {
            button.addEventListener('click', () => {
                input.value = button.dataset.globalSearchExample;
                scheduleSearch();
                input.focus();
            });
        });

        input.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowDown') return;
            const firstResult = results.querySelector('a');
            if (!(firstResult instanceof HTMLAnchorElement)) return;

            event.preventDefault();
            firstResult.focus();
        });

        results.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;

            const links = Array.from(results.querySelectorAll('a'));
            const currentIndex = links.indexOf(document.activeElement);
            if (currentIndex < 0) return;

            event.preventDefault();
            if (event.key === 'ArrowUp' && currentIndex === 0) {
                input.focus();
                return;
            }
            const direction = event.key === 'ArrowDown' ? 1 : -1;
            const nextIndex = (currentIndex + direction + links.length) % links.length;
            links[nextIndex]?.focus();
        });

        openButton.addEventListener('click', () => open(openButton));
        closeButton.addEventListener('click', close);

        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) close();
        });

        dialog.addEventListener('cancel', (event) => {
            event.preventDefault();
            close();
        });

        document.addEventListener('keydown', (event) => {
            const modifier = event.metaKey || event.ctrlKey;
            if (modifier && event.key.toLowerCase() === 'k') {
                event.preventDefault();
                open();
            }
        });
    }
</script>
