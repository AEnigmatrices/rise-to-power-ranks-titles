---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHeader from '../../components/trivia/GuideHeader.astro';
import GuideCard from '../../components/trivia/GuideCard.astro';
import SectionNav from '../../components/navigation/SectionNav.astro';
import { featuredTrivia, officeTrivia } from '../../data/trivia';
import { provinces, regions } from '../../data/geography';
import { sitePath } from '../../lib/routes';
---

<BaseLayout
    title="Historical Guide — Nobunaga's Ambition: Rise to Power"
    description="Historical context for the political institutions, ranks, titles, offices, provinces, and terminology found in Nobunaga's Ambition: Rise to Power."
>
    <main id="top" class="guide-shell">
        <SectionNav current="guide" />

        <GuideHeader
            kicker="Historical Guide"
            title="The stories behind the appointments"
            lede="Explore the political order, geography, institutions, terminology, and status culture behind the names used in Rise to Power."
            backHref={sitePath()}
            backLabel="Back to the overview"
        />

        <section class="guide-section" aria-labelledby="guide-paths-heading">
            <div class="guide-section__heading">
                <div>
                    <p class="guide-section__kicker">Browse the guide</p>
                    <h2 id="guide-paths-heading">Choose a path</h2>
                </div>
                <p>The game mixes two political traditions with old provinces, warrior offices, court titles, and regional institutions. These guides separate the layers.</p>
            </div>

            <div class="guide-route-grid guide-route-grid--three">
                <GuideCard
                    kicker="Political history"
                    japanese="朝廷・幕府・大名"
                    title="Political Context"
                    meta="Court · Shogunate · Daimyo"
                    body="Follow the origins, structures, and decline of the Imperial Court and Muromachi Shogunate, then see why both still mattered as Sengoku daimyo rose."
                    href={sitePath('trivia/context/')}
                />
                <GuideCard
                    kicker="Historical geography"
                    japanese="国・地域"
                    title="Regions & Provinces"
                    meta={`${provinces.length} provinces · ${regions.length} place entries`}
                    body="Browse the old provinces and broader regional names behind provincial offices, Shugo appointments, and regional shogunate commands."
                    href={sitePath('trivia/regions/')}
                />
                <GuideCard
                    kicker="Institutions & status"
                    japanese="官職・役職"
                    title="Offices & Titles"
                    meta={`${officeTrivia.length} historical topics`}
                    body="Read about court institutions, shogunate offices, status groups, title prefixes, and terminology that appears across multiple appointments."
                    href={sitePath('trivia/offices/')}
                />
            </div>
        </section>

        <section class="guide-section guide-section--highlights" aria-labelledby="guide-highlights-heading">
            <div class="guide-section__heading">
                <div>
                    <p class="guide-section__kicker">Historical notes</p>
                    <h2 id="guide-highlights-heading">Eight useful distinctions</h2>
                </div>
                <p>Shorter notes that help make sense of individual labels before diving into a full directory entry.</p>
            </div>

            <div class="guide-card-grid">
                {featuredTrivia.map((item) => (
                    <GuideCard
                        kicker={item.kicker}
                        japanese={item.japanese}
                        title={item.title}
                        body={item.body}
                        source={item.source}
                    />
                ))}
            </div>
        </section>

        <footer class="guide-footer">
            <a href={sitePath()}>← Overview</a>
            <a href={sitePath('reference/')}>Ranks &amp; Titles reference →</a>
        </footer>
    </main>
</BaseLayout>
