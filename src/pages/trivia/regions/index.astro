---
import { Search } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideHeader from '../../../components/trivia/GuideHeader.astro';
import SectionNav from '../../../components/navigation/SectionNav.astro';
import GuideCard from '../../../components/trivia/GuideCard.astro';
import RegionMap from '../../../components/trivia/RegionMap.astro';
import ProvinceOfficeComparison from '../../../components/trivia/ProvinceOfficeComparison.astro';
import { regions } from '../../../data/geography';
import { sitePath } from '../../../lib/routes';

const areas = [...new Set(regions.map((region) => region.area))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
    title="Regions & Provinces — Historical Guide"
    description="Browse the historic provinces, regions, and places referenced by ranks and titles in Nobunaga's Ambition: Rise to Power."
>
    <main id="top" class="guide-shell" data-guide-directory>
        <SectionNav current="guide" />
        <GuideHeader
            kicker="Historical Guide · Geography"
            title="Regions & Provinces"
            lede="Historic provinces are the geography behind provincial court offices and Shugo titles. Modern prefectures below are only an orientation aid."
            backHref={sitePath('trivia/')}
            backLabel="Back to the Historical Guide"
        />

        <section class="guide-directory" aria-labelledby="region-directory-heading">
            <div class="guide-directory__intro">
                <div>
                    <p class="guide-section__kicker">Directory</p>
                    <h2 id="region-directory-heading">Browse every place</h2>
                </div>
                <p>
                    Search by historic name, Japanese name, modern location, or description; or use
                    the area map to narrow the list.
                </p>
            </div>

            <div class="guide-directory__controls">
                <div class="guide-directory__search">
                    <label class="control-label" for="guide-region-search">
                        Search regions and provinces
                    </label>
                    <div class="control-input">
                        <Search size={17} stroke-width={1.8} aria-hidden="true" />
                        <input
                            id="guide-region-search"
                            type="search"
                            autocomplete="off"
                            spellcheck="false"
                            placeholder="Name, Japanese, or location…"
                            data-guide-search
                        />
                        <button
                            class="control-clear"
                            type="button"
                            aria-label="Clear region search"
                            data-guide-search-clear
                            hidden
                        >
                            ×
                        </button>
                    </div>
                </div>
                <div class="guide-directory__select">
                    <label class="control-label" for="guide-region-area">
                        Filter by area
                    </label>
                    <select id="guide-region-area" data-guide-area>
                        <option value="">All areas</option>
                        {areas.map((area) => (
                            <option value={area}>{area}</option>
                        ))}
                    </select>
                </div>
                <button class="reset-button" type="button" data-guide-reset>
                    Reset
                </button>
            </div>

            <div class="directory-results-line">
                <p class="guide-directory__count" data-guide-count role="status" aria-atomic="true">
                    {regions.length} entries
                </p>
                <a href="#directory-results">Skip map to results ↓</a>
            </div>

            <RegionMap />

            <ProvinceOfficeComparison />

            <div id="directory-results" class="guide-card-grid" data-guide-grid tabindex="-1">
                {regions.map((region) => (
                    <GuideCard
                        kicker={`${region.type} · ${region.area}`}
                        japanese={region.japanese}
                        title={region.name}
                        meta={region.location}
                        body={region.body}
                        href={sitePath(`trivia/regions/${region.id}/`)}
                        search={[
                            region.name,
                            region.japanese,
                            region.location,
                            region.body,
                            ...(region.aliases ?? []),
                        ].join(' ')}
                        area={region.area}
                    />
                ))}
            </div>

            <div class="guide-empty-note" data-guide-empty hidden>
                <strong>No matching places</strong>
                <p>Try a different name or clear the search and area filter.</p>
                <button class="reset-button" type="button" data-guide-reset>
                    Clear search &amp; filters
                </button>
            </div>
        </section>

        <footer class="guide-footer">
            <a href={sitePath('trivia/')}>← Historical Guide</a>
            <a href={sitePath('reference/')}>Ranks &amp; Titles reference →</a>
        </footer>
    </main>
</BaseLayout>

<script>
    import '../../../scripts/guide-directory';
</script>
