---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionNav from '../../components/navigation/SectionNav.astro';
import GuideHeader from '../../components/trivia/GuideHeader.astro';
import ItemCatalogue from '../../components/items/ItemCatalogue.astro';
import { sitePath } from '../../lib/routes';
---
<BaseLayout
    title="Items — Nobunaga's Ambition: Rise to Power"
    description="Search and compare all 430 items in 34 original types across four collections, with English and Japanese names, translations, quality, origin and effects."
>
    <main class="guide-shell" id="top">
        <SectionNav current="items" />
        <GuideHeader
            compact
            kicker="Game reference"
            japanese="家宝"
            title="Items"
            lede="430 items across four collections and 34 original types. Choose a collection, explore the quality and type charts, or search the ledger."
            backHref={sitePath()}
            backLabel="Back to the overview"
        />
        <p class="items-audit-note">
            Original game labels and separate English translations are both retained.
            <a href={sitePath('data/item-translations.csv')} download>Download all 430 items and translations (CSV) ↓</a>
        </p>
        <ItemCatalogue />
        <footer class="guide-footer">
            <a href={sitePath()}>← Overview</a>
            <a href={sitePath('ranks/')}>Explore Ranks →</a>
        </footer>
    </main>
</BaseLayout>
