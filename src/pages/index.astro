---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import SectionNav from '../components/navigation/SectionNav.astro';
import IntroductionOverview from '../components/introduction/IntroductionOverview.astro';
import HistoricalGuideTeaser from '../components/trivia/HistoricalGuideTeaser.astro';
import { rankAppointments, titleAppointments } from '../data/appointments';
import { totalRecords } from '../lib/appointments';
import { validateStaticData } from '../data/validation';

validateStaticData();

const rankRecords = totalRecords(rankAppointments);
const titleRecords = totalRecords(titleAppointments);
---

<BaseLayout
    title="Ranks & Titles — Nobunaga's Ambition: Rise to Power"
    description="An introduction to the Imperial Court Ranks and Shogunate Titles represented in Nobunaga's Ambition: Rise to Power (Tenka Sōsei), with links to the full game reference and historical guide."
>
    <main id="top" class="page-shell">
        <SectionNav current="home" />
        <Hero
            rankRecords={rankRecords}
            rankEntries={rankAppointments.length}
            titleRecords={titleRecords}
            titleEntries={titleAppointments.length}
        />

        <IntroductionOverview />
        <HistoricalGuideTeaser />

        <footer class="site-footer">
            <p>
                Unofficial reference for <em>Nobunaga's Ambition: Rise to Power</em> (
                <em>Tenka Sōsei</em>). Game-localized names are preserved for lookup; historical
                readings and context are presented separately.
            </p>
        </footer>
    </main>
</BaseLayout>

<script>
    import '../scripts/legacy-reference-redirect';
</script>
