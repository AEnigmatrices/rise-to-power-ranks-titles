---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SystemOverview from '../components/SystemOverview.astro';
import TriviaGuide from '../components/TriviaGuide.astro';
import ReferenceExplorer from '../components/ReferenceExplorer.astro';
import { ranks } from '../data/ranks';
import { titles } from '../data/titles';

const rankRecords = ranks.reduce((total, entry) => total + entry.count, 0);
const titleRecords = titles.reduce((total, entry) => total + entry.count, 0);
---

<BaseLayout
    title="Ranks & Titles — Nobunaga's Ambition: Rise to Power"
    description="A searchable reference for Imperial Court Ranks and Shogunate Titles in Nobunaga's Ambition: Rise to Power, including Japanese offices and pronunciations, historical translations and trivia, classes, repeated source rows, and stat bonuses."
>
    <main class="page-shell">
        <Hero
            rankRecords={rankRecords}
            rankEntries={ranks.length}
            titleRecords={titleRecords}
            titleEntries={titles.length}
        />

        <SystemOverview />
        <TriviaGuide />
        <ReferenceExplorer />

        <footer class="site-footer">
            <p>
                Unofficial reference for <em>Nobunaga's Ambition: Rise to Power</em>.
                Game-localized names are preserved for lookup; historical translations,
                readings, and contextual trivia are presented separately.
            </p>
        </footer>
    </main>
</BaseLayout>
