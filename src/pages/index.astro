---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import SectionNav from '../components/navigation/SectionNav.astro';
import SystemOverview from '../components/reference/SystemOverview.astro';
import TriviaGuide from '../components/trivia/TriviaGuide.astro';
import ReferenceExplorer from '../components/reference/ReferenceExplorer.astro';
import { rankAppointments, titleAppointments } from '../data/appointments';
import { totalRecords } from '../lib/appointments';
import { validateStaticData } from '../data/validation';

// Fail the build early if authored reference data violates the shared schema.
validateStaticData();

const rankRecords = totalRecords(rankAppointments);
const titleRecords = totalRecords(titleAppointments);
---

<BaseLayout
    title="Ranks & Titles — Nobunaga's Ambition: Rise to Power"
    description="A searchable reference for Imperial Court Ranks and Shogunate Titles in Nobunaga's Ambition: Rise to Power, including Japanese offices and pronunciations, historical translations and trivia, classes, repeated source rows, and stat bonuses."
>
    <main id="top" class="page-shell">
        <Hero
            rankRecords={rankRecords}
            rankEntries={rankAppointments.length}
            titleRecords={titleRecords}
            titleEntries={titleAppointments.length}
        />

        <SectionNav />
        <SystemOverview />
        <ReferenceExplorer />
        <TriviaGuide />

        <footer class="site-footer">
            <p>
                Unofficial reference for <em>Nobunaga's Ambition: Rise to Power</em>.
                Game-localized names are preserved for lookup; historical translations,
                readings, and contextual trivia are presented separately.
            </p>
        </footer>
    </main>
</BaseLayout>
